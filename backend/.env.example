# ---------------------------------------------------------------------------
# Plantilla de variables de entorno del backend de Musicboxd.
# Copiar este archivo a `.env` y completar los valores reales.
# El archivo `.env` NO se commitea (ver .gitignore).
# ---------------------------------------------------------------------------

# --- Aplicación ---
NODE_ENV=development
PORT=3000
# Origen del frontend habilitado para CORS (Vite levanta en 5173 por defecto)
CORS_ORIGIN=http://localhost:5173

# --- Base de datos (MySQL 8) ---
# El puerto depende de cada máquina. Si tenés XAMPP instalado, su MariaDB ocupa
# el 3306 y conviene correr MySQL 8 en otro puerto (por ejemplo 3307).
# Ver la sección "Base de datos local" del README.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=musicboxd
# El backend NO se conecta como root: se usa un usuario con permisos acotados
# al esquema musicboxd (ver el script de creación en el README).
DB_USER=musicboxd_app
DB_PASSWORD=

# SSL: en MySQL local va en false.
# Al pasar a un servicio cloud (Aiven, Clever Cloud) hay que ponerlo en true
# y pegar el certificado CA que provee el servicio en DB_SSL_CA.
DB_SSL=false
DB_SSL_CA=

# Si está en true, Sequelize crea/actualiza las tablas al arrancar (sequelize.sync).
# Sirve durante el desarrollo. En producción debe ir en false.
DB_SYNC=true

# Muestra por consola el SQL que ejecuta Sequelize. Útil para depurar.
DB_LOGGING=true

# --- Autenticación (se usa a partir de la Fase 3) ---
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- Pasarela de pago (se usa a partir de la Fase 6) ---
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# --- Servicio de metadata musical (solo lo usa el script de seed, Fase 2) ---
# La app NO consulta esta API en runtime.
METADATA_API_BASE_URL=https://api.deezer.com
